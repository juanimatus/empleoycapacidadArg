      "parameters": {
        "jsCode": "// Convierte role_families.json del repo en una lista simple para el clasificador.\n// n8n separa el array del JSON en un ítem por familia: acá se vuelven a juntar.\nconst familias = $input.all().map((i) => i.json);\nreturn [{ json: { familias: familias.map((f) => ({ id: f.id, aliases: f.aliases })) } }];\n"
