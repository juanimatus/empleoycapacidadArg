    {
      "parameters": {
        "jsCode": "// Clasifica cada aviso en una familia de rol usando la tabla de alias del repo.\n// Entrada: los avisos de Get on Board (uno por ítem) y la taxonomía del nodo \"Taxonomía\".\nconst norm = (s) =>\n  (s || \"\")\n    .toString()\n    .toLowerCase()\n    .normalize(\"NFD\")\n    .replace(/[̀-ͯ]/g, \"\")\n    .replace(/[^a-z0-9+#.]+/g, \" \")\n    .trim();\n\n// 1) Alias exactos del repo, los más largos primero (\"full stack developer\" antes que \"developer\").\nconst familias = $(\"Taxonomía\").first().json.familias || [];\nconst aliases = [];\nfor (const f of familias) {\n  for (const a of f.aliases) aliases.push({ alias: ` ${norm(a)} `, id: f.id });\n}\naliases.sort((x, y) => y.alias.length - x.alias.length);\n\n// 2) Palabras clave de respaldo, en orden: lo más específico arriba.\nconst reglas = [\n  [\"fullstack\", /full ?stack/],\n  [\"mobile\", /\\b(android|ios|mobile|flutter|react native|kotlin|swift)\\b/],\n  [\"data-science-ml\", /\\b(data scien\\w*|machine learning|ml|mlops|ai|ia|llm|cientific\\w* de datos)\\b/],\n  [\"data\", /\\b(data|datos|bi|analytics|etl|dba|power bi|tableau)\\b/],\n  [\"devops\", /\\b(devops|sre|cloud|aws|azure|gcp|kubernetes|infraestructura|platform engineer)\\b/],\n  [\"security\", /\\b(security|seguridad|ciberseguridad|cybersecurity|pentest\\w*|soc|infosec)\\b/],\n  [\"qa\", /\\b(qa|tester|testing|test|quality|automation)\\b/],\n  [\"ux-ui\", /\\b(ux|ui|diseñ\\w*|disen\\w*|designer|figma|product design\\w*)\\b/],\n  [\"support-sysadmin\", /\\b(soporte|support|help ?desk|sysadmin|mesa de ayuda|it technician)\\b/],\n  [\"product-project\", /\\b(product (owner|manager)|project manager|scrum|agile coach|pm|po|delivery manager)\\b/],\n  [\"frontend\", /\\b(front ?end|react|angular|vue|javascript|maquetador)\\b/],\n  [\"backend\", /\\b(back ?end|java|\\.net|python|node|php|golang|go|ruby|api)\\b/],\n];\n\nconst hoy = new Date().toISOString().slice(0, 10);\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const job = item.json;\n  const a = job.attributes || {};\n  const paises = a.countries || [];\n  const enArgentina = paises.some((p) => norm(p).includes(\"argentina\"));\n  if (!enArgentina) continue; // el índice es sólo para avisos abiertos a Argentina\n\n  const titulo = ` ${norm(a.title)} `;\n  let familia = null;\n  let metodo = \"alias\";\n  for (const x of aliases) {\n    if (titulo.includes(x.alias)) { familia = x.id; break; }\n  }\n  if (!familia) {\n    metodo = \"palabra_clave\";\n    for (const [id, re] of reglas) {\n      if (re.test(titulo)) { familia = id; break; }\n    }\n  }\n  if (!familia) metodo = \"sin_clasificar\";\n\n  salida.push({\n    json: {\n      id: job.id,\n      fecha_relevamiento: hoy,\n      publicado: a.published_at ? new Date(a.published_at * 1000).toISOString().slice(0, 10) : \"\",\n      titulo: a.title || \"\",\n      familia_rol: familia || \"sin_clasificar\",\n      metodo_clasificacion: metodo,\n      categoria_getonbrd: a.category_name || \"\",\n      paises: paises.join(\", \"),\n      remoto: a.remote === true ? \"si\" : \"no\",\n      modalidad_remota: a.remote_modality || \"\",\n      seniority_id: a.seniority?.data?.id ?? \"\",\n      salario_min_usd: a.min_salary ?? \"\",\n      salario_max_usd: a.max_salary ?? \"\",\n      url: job.links?.public_url || \"\",\n    },\n  });\n}\n\nreturn salida;\n"
      },
      "id": "a8",
      "name": "Filtrar Argentina y clasificar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
